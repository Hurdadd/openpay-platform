  "cards": [
    {
      "dot": "cyan",
      "title": "01 \u00b7 Payment intent",
      "items": [
        "A new idempotency key creates a payment in CREATED.",
        "The create use case does not call the PSP yet.",
        "Merchant UUID binding remains an HTTP integration gap."
      ]
    },
    {
      "dot": "amber",
      "title": "02 \u00b7 The missing bridge",
      "items": [
        "Callback transitions save the payment, but create no outbox row.",
        "Kafka publication needs an existing unpublished row.",
        "The map shows current code, not a completed payment journey."
      ]
    },
    {
      "dot": "emerald",
      "title": "03 \u00b7 Durable accounting",
      "items": [
        "One journal entry per eventId; redelivery is a no-op.",
        "Clearing debit + merchant payable credit sum to zero.",
        "PostgreSQL rejects incomplete journals and UPDATE / DELETE."
      ]
    }
  ]
}
